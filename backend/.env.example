# ============================================
# ModelHub Backend 环境变量配置示例
# ============================================
# 复制此文件为 .env 并修改相应的配置值
# cp .env.example .env

# ============================================
# 数据库配置
# ============================================
# 数据库类型 (mysql, postgresql 等)
DB_CONNECTION=mysql

# 数据库主机地址
DB_HOST=localhost

# 数据库端口
DB_PORT=3306

# 数据库名称
DB_DATABASE=modelhub

# 数据库用户名
DB_USERNAME=root

# 数据库密码（如果密码包含特殊字符，会自动编码）
DB_PASSWORD=your_password

# ============================================
# JWT 认证配置
# ============================================
# JWT 密钥（请使用强随机字符串，生产环境必须修改）
SECRET_KEY=your-secret-key-here-change-in-production

# JWT 算法
ALGORITHM=HS256

# Token 过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ============================================
# 嵌入模型配置
# ============================================
# 嵌入模型名称
EMBEDDING_MODEL=text-embedding-v3

# 嵌入模型 API 基础地址
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 嵌入模型 API Key
EMBEDDING_API_KEY=your_embedding_api_key

# ============================================
# ChromaDB 向量数据库配置
# ============================================
# ChromaDB 服务器主机（如果使用 Docker，改为 "host.docker.internal"）
CHROMA_SERVER_HOST=localhost

# ChromaDB 服务器端口
CHROMA_SERVER_PORT=8000

# ChromaDB API 路径（新版本使用 /api/v1）
CHROMA_API_PATH=/api/v1

# ============================================
# Redis 缓存配置（可选但推荐）
# ============================================
# Redis 服务器主机
REDIS_HOST=localhost

# Redis 服务器端口
REDIS_PORT=6379

# Redis 数据库编号
REDIS_DB=0

# Redis 密码（如果设置了密码）
# REDIS_PASSWORD=your_redis_password

# ============================================
# CORS 跨域配置
# ============================================
# 允许的跨域来源（多个用逗号分隔，* 表示允许所有）
CORS_ORIGINS=*

# ============================================
# 其他配置
# ============================================
# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# 应用运行环境 (development, production, testing)
# ENVIRONMENT=development
